# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ==============================================================================

# FRONTEND (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=TikTok Clone
NEXT_PUBLIC_NODE_ENV=development

# BACKEND (FastAPI)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database (PostgreSQL) - ensure postgres service is running
DATABASE_URL=postgresql://tiktok_user:tiktok_password@localhost:5432/tiktok_clone
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis - ensure redis service is running
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# JWT & Security
JWT_SECRET_KEY=dev_secret_key_change_in_production_NOW_!!!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# AWS S3 (optional for development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=tiktok-clone-videos
S3_BUCKET_URL=

# Local storage
UPLOAD_DIR=./uploads

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tiktok-clone.com
SENDGRID_API_KEY=

# PAYMENT
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# EXTERNAL SERVICES
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CELERY
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# MONITORING
SENTRY_DSN=
PROMETHEUS_ENABLED=false
ELASTICSEARCH_URL=

# FLUTTER
FLUTTER_API_URL=http://localhost:8000
FLUTTER_WS_URL=ws://localhost:8000
