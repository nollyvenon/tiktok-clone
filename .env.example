# ==============================================================================
# TikTok Clone Environment Configuration
# Copy to .env and fill in your values
# ==============================================================================

# ==============================================================================
# FRONTEND (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=TikTok Clone
NEXT_PUBLIC_NODE_ENV=development

# ==============================================================================
# BACKEND (FastAPI)
# ==============================================================================

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://tiktok_user:tiktok_password@postgres:5432/tiktok_clone
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# JWT & Security
JWT_SECRET_KEY=your_super_secret_key_change_in_production_NOW
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# ==============================================================================
# STORAGE
# ==============================================================================

# AWS S3 (for videos & images)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=tiktok-clone-videos
S3_BUCKET_URL=https://tiktok-clone-videos.s3.amazonaws.com

# Local storage (for development)
UPLOAD_DIR=./uploads

# ==============================================================================
# EMAIL & NOTIFICATIONS
# ==============================================================================

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@tiktok-clone.com
SMTP_FROM_NAME=TikTok Clone

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_key

# ==============================================================================
# PAYMENT & MONETIZATION
# ==============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (Optional)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================

# OpenAI (for AI features like captions, descriptions)
OPENAI_API_KEY=sk_your_openai_key
OPENAI_MODEL=gpt-4

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# CELERY & BACKGROUND JOBS
# ==============================================================================

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Sentry (Error tracking)
SENTRY_DSN=https://your_sentry_dsn

# Prometheus (Metrics)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Elastic Stack (Logging)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password

# ==============================================================================
# MOBILE (Flutter)
# ==============================================================================

FLUTTER_API_URL=http://localhost:8000
FLUTTER_WS_URL=ws://localhost:8000

# ==============================================================================
# DOCKER & DEPLOYMENT
# ==============================================================================

# Docker
COMPOSE_PROJECT_NAME=tiktok-clone
DOCKER_REGISTRY=docker.io

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily

# ==============================================================================
# DEVELOPMENT & DEBUGGING
# ==============================================================================

# Frontend
NEXT_DEBUG=false
NEXT_TELEMETRY_DISABLED=1

# Backend
SQLALCHEMY_ECHO=false
REQUESTS_TIMEOUT=30

# ==============================================================================
# OPTIONAL: Advanced Configuration
# ==============================================================================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Cache Warming
CACHE_WARMING_ENABLED=false

# Feature Flags
FEATURE_LIVE_STREAMING=true
FEATURE_CREATOR_FUND=true
FEATURE_AI_CAPTIONS=true
FEATURE_SHOP=true
